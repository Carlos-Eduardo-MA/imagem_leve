# Porta do servidor local
PORT=3001

# Segredo que assina o cookie de sessão (mínimo 32 caracteres).
# Gere com: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Client ID OAuth 2.0 do Google Cloud (tipo "Aplicativo da Web").
# Sem ele a aplicação sobe, mas o login fica indisponível.
GOOGLE_CLIENT_ID=

# Opcionais
SESSION_EXPIRES_IN=7d
COOKIE_NAME=imagem_sessao
DATABASE_PATH=./data/users.db
